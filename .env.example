# Скопируйте в .env и заполните. .env в .gitignore.

# Пароль PostgreSQL внутри docker-compose.
POSTGRES_PASSWORD=postgres

# Ключ шифрования токенов: base64 от 32 байт.
# Сгенерировать: openssl rand -base64 32
AI_TOKEN_ENCRYPTION_KEY=

# PAT SourceCraft (сервисный/пользовательский). SourceCraft → Доступ → Персональные токены.
SOURCECRAFT_PAT=

# OAuth-приложение Я ID (https://oauth.yandex.ru/client/new).
# В приложении укажите Redirect URI: http://localhost:8080/auth/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8080/auth/callback

# Хранилище ключей DataProtection по умолчанию — файловое (том srhc-keys в docker-compose).
# Для serverless/мультиинстанса можно указать S3-совместимое хранилище через переменные:
#   DataProtectionStorageOptions__Endpoint=storage.yandexcloud.net
#   DataProtectionStorageOptions__Bucket=<bucket>
#   DataProtectionStorageOptions__AccessKey=<key>
#   DataProtectionStorageOptions__SecretKey=<secret>
