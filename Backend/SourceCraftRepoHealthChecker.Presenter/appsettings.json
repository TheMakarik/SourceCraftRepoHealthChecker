    "TtlMinutes": 10,
    "MaxCachedRepositories": 8
  },
  "AppSecOptions": {
    "BaseUrl": "https://appsec.sourcecraft.tech",
    "TimeoutSeconds": 60,
    "MaxRetries": 3,
    "PageSize": 250,
    "MaxPages": 100
  },
  "YandexIdOptions": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "",
