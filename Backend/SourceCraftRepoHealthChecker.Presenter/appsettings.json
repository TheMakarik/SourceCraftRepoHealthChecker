    "FrontendRedirectUrl": "/",
    "CookieSameSite": "Lax"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SourceCraftServiceOptions": {
    "BaseUrl": "https://api.sourcecraft.tech",
    "ServiceToken": "",
    "TimeoutSeconds": 60,
    "PageSize": 100,
    "MaxItems": 500,
    "MaxResponseLookups": 100,
    "IssueCommentLimit": 20,
    "Concurrency": 4,
    "MaxPages": 100
