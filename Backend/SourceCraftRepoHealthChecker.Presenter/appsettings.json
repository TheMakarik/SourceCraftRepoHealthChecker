    "OAuthUrl": "https://oauth.yandex.ru",
    "LoginUrl": "https://login.yandex.ru",
    "TimeoutSeconds": 10
  },
  "SchedulingOptions": {
    "Enabled": false,
    "RepositoriesRefreshMinutes": 60,
    "AnalysisIntervalMinutes": 720,
    "MaxRepositoriesPerRun": 20
