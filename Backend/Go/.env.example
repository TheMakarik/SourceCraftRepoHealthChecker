# PAT сервиса SourceCraft (публичные данные). Пользовательские запросы идут с токеном из Authorization.
SOURCECRAFT_TOKEN=
# Логин для git по HTTPS; пусто — берётся из GET /user владельца токена.
SOURCECRAFT_GIT_USERNAME=
# AppSec API SourceCraft (SAST/SCA/secret scanning). Токен берётся из запроса/сервисного.
APPSEC_API_URL=https://appsec.sourcecraft.tech
APPSEC_TIMEOUT=15s
APPSEC_MAX_RETRIES=3
# OAuth-приложение Яндекс ID (https://oauth.yandex.ru/client/new, платформа «Веб-сервисы»).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Callback C#-бэкенда; должен совпадать с зарегистрированным в приложении.
YANDEX_REDIRECT_URI=
# Права через пробел; пусто — права из настроек приложения. login:email нужен для email.
YANDEX_SCOPE=login:info login:email

# Секрет служебных эндпоинтов (таймер и Message Queue). Заголовок X-Internal-Token.
INTERNAL_TOKEN=change-me

# Serverless-точка входа cmd/function: адрес; HTTP_ADDR приоритетнее PORT (Cloud Functions).
# HTTP_ADDR=:8080
# PORT=8080
# Circuit breaker к SourceCraft (только serverless-точка входа).
SOURCECRAFT_BREAKER_THRESHOLD=5
SOURCECRAFT_BREAKER_COOLDOWN=30s

# S3-совместимое хранилище (Yandex Object Storage: storage.yandexcloud.net, ru-central1).
S3_ENDPOINT=storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_SSE=true
S3_PREFIX=snapshots
S3_LIFECYCLE_DAYS=1

SNAPSHOT_TTL=3h
GIT_CLONE_TIMEOUT=15m
GIT_MAX_REPO_MB=2048
