      "LicenseWeight": 0.20,
      "ContributingWeight": 0.10,
      "CodeOwnersWeight": 0.10,
      "LocalRunWeight": 0.15,
      "BuildAndTestWeight": 0.15
    },
    "CiCd": {
      "PipelineRunsForFullScore": 10,
