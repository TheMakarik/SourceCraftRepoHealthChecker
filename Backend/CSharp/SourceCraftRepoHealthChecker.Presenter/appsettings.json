{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SourceCraftServiceOptions": {
    "BaseUrl": "http://localhost:8080",
    "TimeoutSeconds": 60,
    "PageSize": 100
  },
  "SchedulingOptions": {
    "Enabled": false,
    "RepositoriesRefreshMinutes": 60,
    "AnalysisIntervalMinutes": 720,
    "MaxRepositoriesPerRun": 20
  },
  "ScalingOptions": {
    "SchedulerEnabled": true,
    "WorkerEnabled": true,
    "WorkerConcurrency": 4,
    "WorkerMaxAttempts": 3,
    "WorkerRetryDelayMilliseconds": 2000,
    "QueueCapacity": 1000
  },
  "AiOptions": {
    "SystemPrompt": "Ты аналитик здоровья репозиториев. Дай краткое резюме состояния проекта и конкретные приоритизированные рекомендации.",
    "OpenAiBaseUrl": "https://api.openai.com/v1",
    "OllamaBaseUrl": "http://localhost:11434/v1",
    "AnthropicBaseUrl": "https://api.anthropic.com/v1/",
    "GoogleGeminiBaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "YandexBaseUrl": "https://llm.api.cloud.yandex.net/v1",
    "XAiBaseUrl": "https://api.x.ai/v1",
    "DeepSeekBaseUrl": "https://api.deepseek.com/v1"
  },
  "AnomalyDetectionOptions": {
    "CommitBurstThreshold": 20,
    "CommitBurstWindowDays": 3,
    "MergeRequestBurstThreshold": 10,
    "MergeRequestBurstWindowDays": 3,
    "NewContributorRecentDays": 14,
    "InactiveAuthorDays": 90,
    "SmallChangeCommitThreshold": 2,
    "SmallChangeRecentDays": 14
  },
  "UserTicketOptions": {
    "LifetimeHours": 12
  },
  "UserOptions": {
    "MaxYaIdLength": 64,
    "MaxLoginLength": 64,
    "MaxDisplayNameLength": 128,
    "MaxEmailLength": 256,
    "MaxSourceCraftTokenLength": 4096
  },
  "UserAiOptions": {
    "MaxBaseUrlLength": 512,
    "MaxModelLength": 128,
    "MaxTokenLength": 4096
  },
  "RepositoryOptions": {
    "MaxSourceCraftIdLength": 128,
    "MaxNameLength": 256,
    "MaxFullNameLength": 512,
    "MaxUrlLength": 512,
    "MaxLanguageLength": 64
  },
  "RecommendationOptions": {
    "MaxTitleLength": 256,
    "MaxProblemLength": 2048,
    "MaxWhyImportantLength": 2048,
    "MaxEvidenceLength": 2048,
    "MaxActionLength": 2048,
    "MaxExpectedImpactLength": 1024,
    "MaxSourceReferenceLength": 512
  },
  "AiTokenEncryptionOptions": {
    "Key": ""
  },
  "DatabaseOptions": {
    "AutoMigrate": false
  },
  "DataProtectionStorageOptions": {
    "Endpoint": "storage.yandexcloud.net",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": "",
    "Prefix": "dataprotection-keys/",
    "UseSsl": true
  },
  "HealthCheckOptions": {
    "MethodologyVersion": "1.0",
    "ScoreScale": {
      "MinimumScore": 0,
      "MaximumScore": 100
    },
    "CategoryWeights": {
      "Security": 0.20,
      "CodeHealth": 0.20,
      "Activity": 0.15,
      "Documentation": 0.15,
      "CiCd": 0.15,
      "Issues": 0.15
    },
    "Security": {
      "CriticalPenalty": 25,
      "HighPenalty": 15,
      "MediumPenalty": 8,
      "LowPenalty": 3,
      "FixedFindingCredit": 3
    },
    "CodeHealth": {
      "TodoPenalty": 1,
      "FixmePenalty": 2,
      "StaleCommentAgeDays": 180,
      "StaleCommentPenalty": 5
    },
    "Activity": {
      "ActiveWithinDays": 30,
      "StaleAfterDays": 365,
      "CommitFrequencyForFullScore": 30,
      "ContributorsForFullScore": 5,
      "ReleasesForFullScore": 4,
      "MergeRequestsForFullScore": 4
    },
    "Documentation": {
      "ReadmeWeight": 0.30,
      "LicenseWeight": 0.20,
      "ContributingWeight": 0.10,
      "CodeOwnersWeight": 0.10,
      "LocalRunWeight": 0.15,
      "BuildAndTestWeight": 0.15
    },
    "CiCd": {
      "PipelineRunsForFullScore": 10,
      "MinimumSuccessRatio": 0.80,
      "MaxPipelineDurationMinutes": 30
    },
    "Issues": {
      "StaleIssueAgeDays": 30,
      "MaxFirstResponseDays": 7,
      "MaxCloseDays": 30,
      "MaxOpenIssues": 50
    },
    "Recommendations": {
      "MinimumAcceptableScore": 70,
      "StrengthScore": 85,
      "HighPriorityScore": 50,
      "CriticalPriorityScore": 25
    }
  }
}
